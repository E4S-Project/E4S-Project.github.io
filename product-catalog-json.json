[
{% for product in site.data.product-catalog.data %}
  {
    "name": {{ product.name | jsonify }},
    "area": {{ product.area | jsonify }},
    "description": {{ product.description | jsonify }},
    "last_updated": {{ product.last_updated | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
